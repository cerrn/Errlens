# GitHub personal access token. Recommended even for public repositories (rate limit 60 -> 5000 requests/hour).
# Required for blame (GraphQL). For private repositories the token needs "Contents: read" on the repository.
GITHUB_TOKEN=

# LLM provider: auto (Claude if ANTHROPIC_API_KEY is set, otherwise Gemini) | anthropic | gemini
LLM_PROVIDER=auto

# Claude API
ANTHROPIC_API_KEY=
ERRLENS_MODEL=claude-sonnet-5

# Google Gemini API (the free tier works: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Language the model writes its explanations in
ERRLENS_OUTPUT_LANGUAGE=English

# Comma-separated allowed origins. Add "*.vercel.app" to allow Vercel preview deployments.
CORS_ORIGINS=http://localhost:3000

# SQLite file (history + result cache)
ERRLENS_DB_PATH=./errlens.db

# Accept a local git repository path as repo_url (offline rehearsals). Keep this off in production.
ERRLENS_ALLOW_LOCAL_REPOS=false

# true: stream a sample result instead of running a real analysis (UI development)
ERRLENS_FIXTURE_MODE=false

# Timeouts (seconds)
GITHUB_TIMEOUT=15
LLM_TIMEOUT=90
PIPELINE_TIMEOUT=240
